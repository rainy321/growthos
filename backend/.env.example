# 复制本文件为 .env 并填入真实值(.env 已被 gitignore,不会上传)
GLM_API_KEY=在此填你的智谱GLM key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flashx
AI_MOCK=0
SESSION_SECRET=请替换为至少32位随机字符串
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
SEED_DEMO_DATA=1
# 生产环境可指向挂载磁盘，例如 /var/data/growth_os.db
DATABASE_PATH=./backend/growth_os.db
